# Stripe secret key — sk_test_... locally, sk_live_... in production
STRIPE_SECRET_KEY=

# Signing secret for the /api/webhook endpoint.
# Local: `stripe listen --forward-to localhost:3000/api/webhook` prints whsec_...
# Deployed: Stripe Dashboard > Developers > Webhooks > your endpoint
STRIPE_WEBHOOK_SECRET=

# Absolute origin, no trailing slash. Used for Checkout success/cancel URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Tax. Leave unset until Dashboard > Tax > Settings has a head office
# address — with it missing, session creation throws and checkout breaks. Even
# once set, tax is only collected in jurisdictions with an active registration.
STRIPE_AUTOMATIC_TAX=false

# Optional — order pings. Unset means notifications are skipped.
DISCORD_WEBHOOK_URL=

# Order persistence. REQUIRED in production — unset, the webhook throws rather
# than write paid orders to an ephemeral filesystem. In dev it falls back to
# data/orders.jsonl. Table definition: supabase/orders.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
